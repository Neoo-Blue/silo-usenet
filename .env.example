# --- Easynews account (Basic auth) ---
EASYNEWS_USER=your_easynews_username
EASYNEWS_PASS=your_easynews_password

# --- Silo (for auto-provisioning the library) ---
# Create an API key in Silo: Settings -> API Keys. Leave blank to skip auto-setup
# and add the library manually.
SILO_URL=http://silo:8080
SILO_API_KEY=sa_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Host path the mount lives on. Your Silo container must bind this SAME path
# (with rslave propagation) so it can see the files.
MOUNT_HOST_PATH=/mnt/library/usenet-live

# Path Silo sees the files at (usually the same as MOUNT_HOST_PATH if Silo binds
# it at the same location). The library is created pointing here.
SILO_MEDIA_PATH=/mnt/library/usenet-live

# --- Dynamic catalog (optional but recommended) ---
# Point at Radarr and the library fills itself: every monitored movie you do not
# have yet (default filter "missing") becomes streamable. Seerr requests create
# monitored Radarr movies, so "request it -> stream it now" works out of the box.
# Leave blank to use only the manual config/titles.json list.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
RADARR_FILTER=missing   # missing = only what you have not downloaded; all = everything
MAX_TITLES=60           # cap total titles to keep the first Silo scan quick (0 = unlimited)

# Optional
LIBRARY_NAME=Usenet Live
VFS_CACHE_MODE=off      # off = pure streaming; full = cache watched bytes to disk
REQUIRE_NONRAR_RATIO=0.5  # prefer non-RAR posts unless the alternative is < this fraction of the best
